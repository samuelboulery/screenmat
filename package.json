{
  "name": "screenmat",
  "private": true,
  "version": "0.1.0",
  "description": "Turn a raw screenshot into a shareable visual — macOS-style window, generative background, annotations, redaction. Runs entirely in the browser.",
  "license": "MIT",
  "author": "Samuel Boulery",
  "homepage": "https://github.com/samuelboulery/screenmat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelboulery/screenmat.git"
  },
  "bugs": {
    "url": "https://github.com/samuelboulery/screenmat/issues"
  },
  "keywords": [
    "screenshot",
    "canvas",
    "image",
    "mockup",
    "annotation",
    "redaction",
    "webp",
    "cli",
    "mcp",
    "offline"
  ],
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "screenmat": "./cli/main.ts"
  },
  "exports": {
    "./node": "./cli/api.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node cli/main.ts",
    "mcp": "node cli/mcp.ts"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^1.0.6",
    "zod": "^4.4.3"
  }
}
